{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://storymachine.dev/schemas/v1/story.schema.json",
  "title": "Story",
  "type": "object",
  "required": ["schemaVersion", "beats"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string" },
    "beats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["text"],
        "properties": {
          "text": { "type": "string" },
          "durationMs": { "type": "number" }
        }
      }
    }
  }
}
