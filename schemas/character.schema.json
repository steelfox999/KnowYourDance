{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://storymachine.dev/schemas/v1/character.schema.json",
  "title": "Characters",
  "type": "object",
  "required": ["schemaVersion", "characters"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string" },
    "characters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "weights", "reveal"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "title": { "type": "string" },
          "portrait": { "type": "string" },
          "promptSet": { "type": "string" },
          "weights": { "type": "object", "additionalProperties": { "type": "number" } },
          "reveal": {
            "type": "object",
            "required": ["template"],
            "description": "The reveal MUST explain why this character chose this visitor.",
            "properties": {
              "template": { "type": "string", "description": "Tokens: {name} {title} {topTrait} {reason}" },
              "reasons": { "type": "object", "additionalProperties": { "type": "string" } },
              "defaultReason": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
