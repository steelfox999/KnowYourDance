{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://storymachine.dev/schemas/v1/print.schema.json",
  "title": "PrintTemplate",
  "type": "object",
  "required": ["schemaVersion", "page"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string" },
    "title": { "type": "string" },
    "layout": { "type": "string" },
    "page": {
      "type": "object",
      "required": ["size"],
      "properties": {
        "size": { "enum": ["A5", "A6", "4x6"] },
        "widthMm": { "type": "number" },
        "heightMm": { "type": "number" },
        "orientation": { "enum": ["portrait", "landscape"] },
        "dpi": { "type": "number" }
      }
    },
    "grid": {
      "type": "object",
      "required": ["cols", "rows"],
      "properties": { "cols": { "type": "integer" }, "rows": { "type": "integer" } }
    },
    "marginPct": { "type": "number" },
    "gutterPct": { "type": "number" },
    "background": { "type": "string" },
    "order": {
      "type": "array",
      "items": { "enum": ["original", "mask", "costume", "combined", "maskVar1", "maskVar2"] }
    },
    "labels": { "type": "object", "additionalProperties": { "type": "string" } },
    "labelColor": { "type": "string" },
    "titleColor": { "type": "string" },
    "descriptionColor": { "type": "string" },
    "footerColor": { "type": "string" },
    "logos": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "src": { "type": "string" },
          "widthPct": { "type": "number" },
          "heightPct": { "type": "number" },
          "xPct": { "type": "number" },
          "yPct": { "type": "number" }
        }
      }
    },
    "footer": { "type": "string" },
    "frame": { "type": "string", "description": "Optional transparent overlay PNG/SVG covering the full sheet (venue branding)." }
  }
}
