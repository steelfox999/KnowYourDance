{
  "name": "story-machine",
  "productName": "Story Machine",
  "version": "1.0.0",
  "description": "Offline-first, config-driven interactive storytelling & photo-transformation kiosk platform.",
  "author": "Story Machine Platform",
  "license": "SEE LICENSE IN LICENSE.txt",
  "main": "electron/main.js",
  "scripts": {
    "build": "vite build",
    "start": "npm run build && electron .",
    "web": "npm run build && node scripts/serve.js",
    "test": "node --test tests/*.test.js tests/*.test.mjs",
    "check": "node scripts/validate-config.js themes/know-your-dance",
    "assets": "node scripts/generate-assets.js themes/know-your-dance",
    "pack:win": "npm run build && electron-builder --win --publish never",
    "pack:mac": "npm run build && electron-builder --mac --publish never",
    "pack:all": "npm run build && electron-builder --win --mac --publish never"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.2",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.2",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.16",
    "tailwindcss": "^4.3.2",
    "vite": "^8.1.3"
  },
  "build": {
    "appId": "com.storymachine.kiosk",
    "productName": "Story Machine",
    "files": [
      "electron/**",
      "dist/**",
      "themes/**",
      "schemas/**",
      "vendor/**"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "StoryMachine-Setup-${version}.exe"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "StoryMachine-${version}-${arch}.${ext}",
      "category": "public.app-category.entertainment",
      "extendInfo": {
        "NSCameraUsageDescription": "Story Machine uses the camera to capture participant portraits for the Know Your Dance experience."
      }
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "gsap": "^3.15.0",
    "lucide-react": "^1.23.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  }
}
